      "entryId": "N5-081",
      "field": "caution",
      "classification": "confirmed-correction",
      "original": "“三点に”是时间点，“三時間”是长度。",
      "suggested": "“三時（さんじ）に”是时间点，“三時間（さんじかん）”是长度。",
      "reason": "三点是中文时刻说法；作为带に的日语示例应写三時。",
      "confidence": "high",
      "affectsJapaneseAudio": false,
      "referenceUrls": [
        "https://www.coelang.tufs.ac.jp/mt/ja/gmod/contents/explanation/018.html"
      ]
