    },
    {
      "entryId": "N5-001",
      "exampleIndex": 1,
      "text": "ここは図書館だ。",
      "voice": "nanami",
      "src": "/audio/voices/nanami/N5-001-2.mp3",
      "pdfPage": 10,
      "srt": "/audio/voices/nanami/N5-001-2.srt",
      "durationSeconds": 2.232
    },
    {
      "entryId": "N5-002",
      "exampleIndex": 0,
      "text": "今日は家で勉強します。",
      "voice": "nanami",
      "src": "/audio/voices/nanami/N5-002-1.mp3",
      "pdfPage": 10,
      "srt": "/audio/voices/nanami/N5-002-1.srt",
      "durationSeconds": 2.784
    },
    {
      "entryId": "N5-002",
      "exampleIndex": 1,
      "text": "肉は食べますが、魚は食べません。",
      "voice": "nanami",
      "src": "/audio/voices/nanami/N5-002-2.mp3",
      "pdfPage": 10,
      "srt": "/audio/voices/nanami/N5-002-2.srt",
      "durationSeconds": 3.768
    },
    {
      "entryId": "N5-003",
      "exampleIndex": 0,
      "text": "誰が来ますか。",
      "voice": "nanami",
      "src": "/audio/voices/nanami/N5-003-1.mp3",
