    {
      "entryId": "N5-001",
      "exampleIndex": 0,
      "text": "私は大学生です。",
      "voice": "nanami",
      "src": "/audio/voices/nanami/N5-001-1.mp3",
      "pdfPage": 10,
      "srt": "/audio/voices/nanami/N5-001-1.srt",
      "durationSeconds": 2.64
    },
    {
      "entryId": "N5-001",
      "exampleIndex": 1,
      "text": "ここは図書館だ。",
      "voice": "nanami",
      "src": "/audio/voices/nanami/N5-001-2.mp3",
      "pdfPage": 10,
      "srt": "/audio/voices/nanami/N5-001-2.srt",
      "durationSeconds": 2.232
    },
    {
      "entryId": "N5-002",
      "exampleIndex": 0,
      "text": "今日は家で勉強します。",
      "voice": "nanami",
      "src": "/audio/voices/nanami/N5-002-1.mp3",
      "pdfPage": 10,
      "srt": "/audio/voices/nanami/N5-002-1.srt",
      "durationSeconds": 2.784
    },
    {
      "entryId": "N5-002",
      "exampleIndex": 1,
      "text": "肉は食べますが、魚は食べません。",
      "voice": "nanami",
      "src": "/audio/voices/nanami/N5-002-2.mp3",
      "pdfPage": 10,
      "srt": "/audio/voices/nanami/N5-002-2.srt",
      "durationSeconds": 3.768
    },
    {
      "entryId": "N5-003",
      "exampleIndex": 0,
      "text": "誰が来ますか。",
      "voice": "nanami",
      "src": "/audio/voices/nanami/N5-003-1.mp3",
      "pdfPage": 11,
      "srt": "/audio/voices/nanami/N5-003-1.srt",
      "durationSeconds": 2.064
    },
    {
      "entryId": "N5-003",
      "exampleIndex": 1,
      "text": "外で雨が降っています。",
      "voice": "nanami",
      "src": "/audio/voices/nanami/N5-003-2.mp3",
      "pdfPage": 11,
      "srt": "/audio/voices/nanami/N5-003-2.srt",
      "durationSeconds": 2.808
    },
    {
      "entryId": "N4-001",
      "exampleIndex": 0,
      "text": "この方法は便利だと思います。",
      "voice": "nanami",
      "src": "/audio/voices/nanami/N4-001-1.mp3",
      "pdfPage": 55,
      "srt": "/audio/voices/nanami/N4-001-1.srt",
      "durationSeconds": 3.192
    },
    {
      "entryId": "N4-001",
      "exampleIndex": 1,
      "text": "明日は雨が降ると思います。",
      "voice": "nanami",
      "src": "/audio/voices/nanami/N4-001-2.mp3",
      "pdfPage": 55,
      "srt": "/audio/voices/nanami/N4-001-2.srt",
      "durationSeconds": 3.0
    },
    {
      "entryId": "N4-002",
      "exampleIndex": 0,
      "text": "これは「さくら」という店です。",
      "voice": "nanami",
      "src": "/audio/voices/nanami/N4-002-1.mp3",
      "pdfPage": 55,
      "srt": "/audio/voices/nanami/N4-002-1.srt",
      "durationSeconds": 3.288
    },
    {
      "entryId": "N4-002",
      "exampleIndex": 1,
      "text": "試験が延期になったという連絡が来ました。",
      "voice": "nanami",
      "src": "/audio/voices/nanami/N4-002-2.mp3",
      "pdfPage": 55,
      "srt": "/audio/voices/nanami/N4-002-2.srt",
      "durationSeconds": 3.912
    },
    {
      "entryId": "N4-003",
      "exampleIndex": 0,
      "text": "先生は「明日は休みです」と言いました。",
      "voice": "nanami",
      "src": "/audio/voices/nanami/N4-003-1.mp3",
      "pdfPage": 56,
      "srt": "/audio/voices/nanami/N4-003-1.srt",
      "durationSeconds": 4.416
    },
    {
      "entryId": "N4-003",
      "exampleIndex": 1,
      "text": "友達は少し遅れると言っていました。",
      "voice": "nanami",
      "src": "/audio/voices/nanami/N4-003-2.mp3",
      "pdfPage": 56,
      "srt": "/audio/voices/nanami/N4-003-2.srt",
      "durationSeconds": 3.648
    },
