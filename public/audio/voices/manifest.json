      "srt": "/audio/voices/nanami/N5-003-1.srt",
      "durationSeconds": 2.064
    },
    {
      "entryId": "N5-003",
      "exampleIndex": 1,
      "text": "外で雨が降っています。",
      "voice": "nanami",
      "src": "/audio/voices/nanami/N5-003-2.mp3",
      "pdfPage": 11,
      "srt": "/audio/voices/nanami/N5-003-2.srt",
      "durationSeconds": 2.808
    },
    {
      "entryId": "N4-001",
      "exampleIndex": 0,
      "text": "この方法は便利だと思います。",
      "voice": "nanami",
